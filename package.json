{
  "name": "mac-claudecode-grid",
  "version": "0.1.0",
  "description": "Browser-based grid dashboard for running and monitoring multiple Claude Code sessions side by side",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:remote": "CC_GRID_REMOTE=1 node server.js",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');try{const d=path.join(path.dirname(require.resolve('node-pty/package.json')),'prebuilds');for(const a of fs.readdirSync(d)){const f=path.join(d,a,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}}catch{}\"",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "terminal",
    "dashboard",
    "node-pty",
    "xterm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  }
}